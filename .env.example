# Copy to .env.local and fill in. Anything prefixed with VITE_ is embedded in
# the client bundle — never put the service_role key here.
VITE_SUPABASE_URL=https://rflchhduezarbuaqvnra.supabase.co
VITE_SUPABASE_ANON_KEY=

# Canonical origin used by index.html's canonical link, OG/Twitter tags, and
# JSON-LD (no trailing slash).
VITE_SITE_URL=https://eduparty.online

# AdSense publisher ID. Empty/missing means AdSlot and InlineAdSlot render
# nothing — no placeholder box goes out in production until this is set.
VITE_ADSENSE_PUBLISHER_ID=

# GA4 measurement ID (G-XXXXXXXXXX) from analytics.google.com. Empty/missing
# means the gtag.js snippet never loads — no tracking script ships until this
# is set. See issue #91.
VITE_GA_MEASUREMENT_ID=

# Sentry DSN from your Sentry project's settings. Empty/missing means Sentry
# is never initialized — no error/performance data ships until this is set.
# See issue #95.
VITE_SENTRY_DSN=

# Only needed at build time, to upload source maps so Sentry stack traces
# point at real source lines instead of minified output (see vite.config.ts).
# A Sentry auth token with project:releases scope. Missing means the build
# still succeeds, it just skips the upload — Sentry falls back to minified
# traces for that release.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
